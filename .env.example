# Server
PORT=8080
# Public site URL used in API thumbnail_url / video_url.
# Recommended on Hostinger: leave empty (relative /media/... URLs).
# If set, must be exact HTTPS domain of THIS deploy — no trailing slash,
# never http://localhost (mixed content / wrong host).
PUBLIC_BASE_URL=
SESSION_SECRET=change-this-to-a-long-random-string
# Set to production on Hostinger so session cookies are marked Secure.
NODE_ENV=development
# If ffmpeg still fails on Hostinger, set to 1 to skip transcode and keep originals.
SKIP_VIDEO_TRANSCODE=0

# Where uploaded media is stored. Leave empty locally (uses public/media).
# On Hostinger set it to a folder OUTSIDE the deploy folder, or every deploy
# loses all videos. Example:
# MEDIA_ROOT=/home/u101737716/video-media
MEDIA_ROOT=

# Adaptive streaming: each upload becomes HLS in 1080p/720p/480p/360p.
# Player picks quality from the viewer's bandwidth; viewer can also choose.
ENABLE_HLS=1
# Also keep one MP4 (copied from the 1080p stream, no re-encode) so video_url
# keeps working for apps that need a plain MP4. Set 0 to save disk space.
HLS_KEEP_MP4=1
# How many videos convert at the same time (about 1 per 2-4 CPU cores).
TRANSCODE_CONCURRENCY=1
# Threads per ffmpeg encoder. Keep low on shared hosting (Hostinger): 2
FFMPEG_THREADS=2
# auto = all qualities in one pass, falls back to one-at-a-time if the host
# refuses; sequential = always one at a time (slowest, lowest memory)
HLS_MODE=auto
# x264 speed/size trade-off: veryfast (default) | faster | medium (smaller files, ~2-3x slower)
X264_PRESET=veryfast

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=video_cms_user
DB_PASSWORD=change-me
DB_NAME=video_cms

# First-run admin account (used only by `npm run init-db`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
